# Copy this to .env and fill in real values. .env is gitignored.

# OpenAI — used for both ingestion (gpt-4o-mini) and chat (gpt-4o)
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Azure Blob Storage (for wiki sync + conversation logging) — set after Phase 4
AZURE_STORAGE_CONNECTION_STRING=

# Azure Application Insights — set after Phase 4
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Per-deployment salt for HMAC-hashing IP addresses in conversation logs
RATE_LIMIT_SALT=change-me-to-a-random-string

# Chat deployment variant: "public" (7 cleared docs) or "full" (all 51)
CORPUS_VARIANT=public

# Internal password gate (only set on internal deployment)
ENABLE_PASSWORD_GATE=false
AMOS_PASSWORD=

# Budget controls
BUDGET_MONTHLY_USD=15
BUDGET_HARD_CAP_USD=20
